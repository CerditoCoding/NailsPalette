// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Collection {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Shape {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Size {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[] @relation("ProductSizes")
}

model DesignLevel {
  id            String    @id @default(cuid())
  name          String    @unique
  priceModifier Int       @default(0)
  createdAt     DateTime  @default(now())
  products      Product[]
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String
  price         Int
  coverImage    String
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  collectionId  String
  collection    Collection     @relation(fields: [collectionId], references: [id])
  shapeId       String
  shape         Shape          @relation(fields: [shapeId], references: [id])
  designLevelId String
  designLevel   DesignLevel    @relation(fields: [designLevelId], references: [id])
  sizes         Size[]         @relation("ProductSizes")
  images        ProductImage[]
  orderItems    OrderItem[]
}

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  cpFrom    Int
  cpTo      Int
  price     Int
  createdAt DateTime @default(now())
}

model ShowcasePhoto {
  id        String   @id @default(cuid())
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model DesignPhoto {
  id        String   @id @default(cuid())
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  position  Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id               String      @id @default(cuid())
  orderNumber      Int         @unique
  firstName        String
  lastName         String
  email            String
  phone            String
  city             String
  province         String
  postalCode       String
  notes            String?
  shippingEstimate Int?
  total            Int
  status           String      @default("NUEVO")
  trackingCode     String?
  trackingUrl      String?
  createdAt        DateTime    @default(now())
  items            OrderItem[]

  @@index([status])
}

model FreedOrderNumber {
  id      String   @id @default(cuid())
  number  Int      @unique
  freedAt DateTime @default(now())
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  size        String
  quantity    Int
  unitPrice   Int
}
