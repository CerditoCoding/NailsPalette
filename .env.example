# Postgres — en Vercel, la integración de Vercel Postgres/Neon inyecta estas
# variables automáticamente (DATABASE_URL pooled + DATABASE_URL_UNPOOLED directa).
# En local, pegá acá el connection string de tu base (podés usar el mismo para ambas).
DATABASE_URL="postgres://usuario:password@host:5432/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://usuario:password@host:5432/db?sslmode=require"

# Panel de administración
ADMIN_PASSWORD="cambiar-esta-contraseña"
ADMIN_SESSION_SECRET="una-cadena-aleatoria-larga-y-secreta"

# Número de WhatsApp del negocio (recibe consultas y notificaciones de pedidos nuevos)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000

# Vercel Blob (storage de imágenes de las publicaciones). Se inyecta solo al
# agregar "Blob" en Vercel → Storage. En local, generá un token en esa misma
# pantalla si necesitás subir imágenes desde tu máquina.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Resend (envío de mails transaccionales: confirmación de pedido y avisos
# de cambio de estado) — OPCIONAL. Sin estas variables cargadas, el sitio
# sigue funcionando normal y simplemente no manda esos mails. Hace falta un
# dominio propio verificado en Resend (no alcanza con el subdominio de
# Vercel) — registrate gratis en https://resend.com para conseguir la key.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# URL base del sitio, para armar los links de "ver mi pedido" en los mails.
NEXT_PUBLIC_SITE_URL="https://nails-palette.vercel.app"

# MiCorreo (API de Correo Argentino) — OPCIONAL. Si estas variables no están
# cargadas, el sitio sigue cotizando el envío con las zonas manuales que se
# cargan en /admin/envios. Si se cargan, el carrito empieza a cotizar en vivo
# contra Correo Argentino automáticamente, sin tocar código. Te registrás
# gratis en https://www.correoargentino.com.ar/MiCorreo para conseguirlas.
MICORREO_USER=""
MICORREO_PASSWORD=""
MICORREO_CUSTOMER_ID=""
# CP desde donde despachás los pedidos (tu domicilio/local).
MICORREO_ORIGIN_POSTAL_CODE=""
# Dejar en blanco para producción. Para probar contra el ambiente de test de
# Correo Argentino: https://apitest.correoargentino.com.ar/micorreo/v1
MICORREO_BASE_URL=""
# Dimensiones fijas del paquete tipo "sobre" que se cotiza (por defecto ya
# tienen un valor razonable para press on nails, no hace falta cargarlas).
MICORREO_PACKAGE_WEIGHT_G=""
MICORREO_PACKAGE_HEIGHT_CM=""
MICORREO_PACKAGE_WIDTH_CM=""
MICORREO_PACKAGE_LENGTH_CM=""
